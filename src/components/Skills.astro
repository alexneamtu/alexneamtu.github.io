---
const skillGroups = [
  {
    title: 'Languages',
    skills: ['TypeScript', 'JavaScript', 'Python', 'Go', 'PHP', 'SQL', 'Bash'],
  },
  {
    title: 'AI',
    skills: ['Artificial Intelligence (AI)', 'LLM APIs (Claude, OpenAI, Gemini)', 'LiteLLM', 'Generative video pipelines', 'ML inference APIs', 'Claude Code', 'Codex'],
  },
  {
    title: 'Backend',
    skills: ['Node.js', 'GraphQL', 'REST APIs', 'Prisma', 'FastAPI', 'Django', 'Fastify'],
  },
  {
    title: 'Cloud & Infrastructure',
    skills: ['AWS (Lambda, Step Functions, ECS, SQS/SNS)', 'Infrastructure as code (IaC)', 'AWS CDK', 'Pulumi', 'GCP', 'Docker', 'Kubernetes', 'Cloudflare Workers'],
  },
  {
    title: 'Data',
    skills: ['PostgreSQL', 'DynamoDB', 'Elasticsearch', 'MongoDB', 'Redis', 'Airflow', 'dbt'],
  },
  {
    title: 'Frontend & Tooling',
    skills: ['React', 'Vite', 'Turborepo', 'pnpm', 'Jest', 'Playwright'],
  },
];

---
<section class="section" id="skills">
  <h2 class="section-heading">Skills</h2>
  <dl class="skill-groups">
    {skillGroups.map(group => (
      <div class="skill-group">
        <dt class="skill-group-title">{group.title}</dt>
        <dd class="skill-list">{group.skills.join(', ')}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .skill-groups {
    display: grid;
    gap: var(--space-sm);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-md);
  }

  .skill-group-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding-top: 0.15rem;
  }

  .skill-list {
    font-size: 0.925rem;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .skill-group {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
