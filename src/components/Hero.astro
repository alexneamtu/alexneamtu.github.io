---
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/alexneamtu' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/alexneamtu/' },
  { label: 'X (Twitter)', href: 'https://x.com/neamtualexandru' },
];
---
<section class="hero" id="hero">
  <p class="hero-tagline">Backend · Platform · AI</p>
  <h1 class="hero-name">Alex Neamtu</h1>
  <p class="hero-title">Senior Software Engineer</p>
  <p class="hero-location">Bucharest, Romania · Remote only · EU citizen, no visa sponsorship needed</p>
  <div class="hero-actions">
    <a class="hero-btn hero-btn-primary" href="mailto:alexneamtu@gmail.com">Email me</a>
    <button class="hero-btn" onclick="window.print()">↓ Download Resume</button>
  </div>
  <div class="hero-links">
    {socialLinks.map(link => (
      <a href={link.href} class="hero-social" target="_blank" rel="noopener noreferrer">{link.label}</a>
    ))}
  </div>
  <div class="hero-print-links">
    <span>alexneamtu@gmail.com</span>
    <span>github.com/alexneamtu</span>
    <span>linkedin.com/in/alexneamtu</span>
    <span>x.com/neamtualexandru</span>
  </div>
</section>

<style>
  .hero {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-tagline {
    font-family: var(--font-mono);
    color: var(--color-accent);
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--space-sm);
    color: var(--color-text);
  }

  .hero-title {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .hero-location {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .hero-btn {
    border: 1px solid var(--color-accent);
    background: none;
    color: var(--color-accent);
    padding: 0.55rem 1.25rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }

  .hero-btn:hover,
  .hero-btn-primary {
    background-color: var(--color-accent);
    color: var(--color-bg);
    opacity: 1;
  }

  .hero-btn-primary:hover {
    opacity: 0.85;
  }

  .hero-links {
    display: flex;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .hero-social {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hero-social:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .hero-print-links {
    display: none;
  }

</style>
