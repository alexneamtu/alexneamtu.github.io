---
const projects = [
  {
    name: 'SendRec',
    url: 'https://sendrec.eu',
    role: 'Founder & Developer',
    period: '2026 – Present',
    summary: 'Open-source, EU-hosted alternative to Loom for teams that need data to stay in Europe: browser screen and camera recording, AI transcription, team workspaces with SSO, SAML, and SCIM. Self-host with Docker or use the hosted version in EU datacenters. 150+ users and first paying customers, 370+ videos processed, 64 GitHub stars and 170+ releases in 10 months.',
  },
  {
    name: 'UpgradeYou',
    url: 'https://upgradeyou.ro',
    role: 'Founder & Developer',
    period: '2026 – Present',
    summary: 'AI CV review: upload a CV and get a report with specific fixes and rewrites, from a pipeline that routes across several LLMs (Gemini, DeepSeek, Mistral, Groq) and adds web-search context. Python, FastAPI, TypeScript, English and Romanian, PDF and Word export, Stripe.',
  },
  {
    name: 'pairpilot.ai',
    url: null,
    role: 'Creator',
    period: '',
    summary: 'Multi-model agentic pair-programming CLI (Claude + OpenAI) with a writer/reviewer loop and repo-aware file, shell, and git tools.',
  },
  {
    name: 'htoprc.dev',
    url: 'https://htoprc.dev',
    role: 'Creator',
    period: '',
    summary: 'Web app to browse, preview, and edit htop configurations. React 19, Cloudflare Workers, GraphQL, with a published npm package.',
  },
];
---
<section class="section" id="projects">
  <h2 class="section-heading">Projects</h2>
  <div class="project-list">
    {projects.map(p => (
      <div class="project">
        <div class="project-header">
          <h3 class="project-name">
            {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}
            <span class="project-role"> · {p.role}</span>
          </h3>
          {p.period && <span class="project-period">{p.period}</span>}
        </div>
        <p class="project-summary">{p.summary}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .project-list {
    display: grid;
    gap: var(--space-lg);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
  }

  .project-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .project-period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-role {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .project-summary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: var(--space-xs);
  }

  .project {
    break-inside: avoid;
  }
</style>
