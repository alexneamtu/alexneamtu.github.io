---
const projects = [
  {
    name: 'SendRec',
    url: 'https://sendrec.eu',
    role: 'Neamtu Alexandru PFA',
    period: 'Feb 2026 – Present',
    summary: 'Building an open-source alternative to Loom for teams that need their data to stay in the EU. SendRec lets you record your screen, share videos with your team, and keep full control of your data. GDPR native, self-hostable, no US cloud dependency. Built with Go, React, PostgreSQL. Hosted on European infrastructure (Hetzner, Germany). Licensed under AGPLv3.',
  },
  {
    name: 'Coinzone Wallet',
    url: null,
    role: 'Coinzone',
    period: 'Jan 2015 – Aug 2015',
    summary: 'Wallet application built from scratch using Open Source technologies.',
  },
  {
    name: 'Teatrul Romanesc',
    url: null,
    role: 'Neamtu Alexandru PFA',
    period: 'Aug 2012 – Dec 2014',
    summary: 'Teatrul Romanesc is an website that monitors cultural events all over Romania.',
  },
  {
    name: 'Eventful Theme',
    url: null,
    role: 'Neamtu Alexandru PFA',
    period: 'Jun 2012 – Dec 2013',
    summary: 'Eventful is a Premium WordPress Theme developed to create events-oriented websites. Taking advantage of the powerful custom-post-type feature in WordPress (v 3.0 and above), we created a complex platform that can handle events, locations and artists with a bundle of features and options.',
  },
  {
    name: 'Gazeta de Arta Politica',
    url: null,
    role: 'Neamtu Alexandru PFA',
    period: 'Jan 2010 – Dec 2012',
    summary: 'Gazeta de Arta Politica is an online magazine.',
  },
];
---
<section class="section" id="projects">
  <h2 class="section-heading">Projects</h2>
  <div class="project-list">
    {projects.map(p => (
      <div class="project">
        <div class="project-header">
          <h3 class="project-name">
            {p.url ? <a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a> : p.name}
            <span class="project-role"> · {p.role}</span>
          </h3>
          {p.period && <span class="project-period">{p.period}</span>}
        </div>
        <p class="project-summary">{p.summary}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .project-list {
    display: grid;
    gap: var(--space-lg);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-md);
  }

  .project-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .project-period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-role {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .project-summary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: var(--space-xs);
  }

  .project {
    break-inside: avoid;
  }
</style>
