    ],
    tech: ['Node.js', 'TypeScript', 'React', 'Turborepo', 'pnpm', 'Docker', 'AWS'],
  },
  {
    role: 'Senior Software Engineer',
    company: 'Sand Technologies',
    url: 'https://www.sandtech.com/',
    period: '2021 – Present',
    summary: 'Cloud-native serverless APIs and workflows on AWS for AI and media products.',
    details: [
      'Designed and implemented highly scalable, event-driven APIs and workflows leveraging AWS services.',
      'Diginym — AI content agency creating broadcast-quality video content using proprietary workflows.',
      'CLIPr — Video analysis and management platform using AI and machine learning.',
      'CardSeer — Trading card marketplace and discovery platform.',
      'The Room — Talent matching platform for the African Leadership Group.',
    ],
    tech: ['Node.js', 'Python', 'TypeScript', 'GraphQL', 'PostgreSQL', 'DynamoDB', 'Elasticsearch', 'AWS CDK', 'Lambda', 'Step Functions', 'SQS', 'SNS'],
  },
  {
