<section class="section" id="experience">
  <h2 class="section-heading">Experience</h2>
  <div class="timeline">
    {experiences.map((exp, i) => (
      <div class:list={['timeline-item', { current: i === 0, compact: !exp.details }]}>
        <div class="timeline-header">
          <div>
            <h3 class="timeline-role">{exp.role}</h3>
            <p class="timeline-company">
              {exp.url ? (
                <a href={exp.url} target="_blank" rel="noopener noreferrer">{exp.company}</a>
              ) : (
                exp.company
              )}
              {exp.type && <span class="timeline-type"> · {exp.type}</span>}
            </p>
          </div>
          <span class="timeline-period">{exp.period}</span>
        </div>
        {exp.summary && <p class="timeline-summary">{exp.summary}</p>}
        {exp.details && (
          <ul class="exp-details">
            {exp.details.map(detail => (
              <li set:html={detail.replace(/^(.+?) — /, '<strong>$1</strong> — ')} />
            ))}
          </ul>
        )}
        {exp.tech && (
          <div class="exp-tech">
            {exp.tech.map(t => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
