    company: 'Self-Employed',
    url: null,
    period: '2012 – Present',
    summary: 'Independent projects in civic tech, investigative journalism, and document search.',
    details: [
      'Risc Seismic Bucuresti — Fast, free tool to check buildings with seismic risk in Bucharest.',
