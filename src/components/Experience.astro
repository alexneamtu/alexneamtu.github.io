---
<section class="section" id="experience">
  <h2 class="section-heading">Experience</h2>
  <div class="timeline">
    {experiences.map(exp => (
      <div class="timeline-item">
        {exp.details ? (
          <details class="drawer">
            <summary class="drawer-summary">
              <div class="timeline-header">
                <div>
                  <h3 class="timeline-role">{exp.role}</h3>
                  <p class="timeline-company">
                    {exp.url ? (
                      <a href={exp.url} target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">{exp.company}</a>
                    ) : (
                      exp.company
                    )}
                  </p>
                </div>
                <span class="timeline-period">{exp.period}</span>
              </div>
              {exp.summary && <p class="timeline-summary">{exp.summary}</p>}
              <span class="drawer-chevron" aria-hidden="true"></span>
            </summary>
            <div class="drawer-content">
              <ul class="drawer-details">
                {exp.details.map(detail => (
                  <li>{detail}</li>
                ))}
              </ul>
              {exp.tech && (
                <div class="drawer-tech">
                  {exp.tech.map(t => (
                    <span class="tech-tag">{t}</span>
                  ))}
                </div>
              )}
            </div>
          </details>
        ) : (
          <div>
            <div class="timeline-header">
              <div>
                <h3 class="timeline-role">{exp.role}</h3>
                <p class="timeline-company">
                  {exp.url ? (
                    <a href={exp.url} target="_blank" rel="noopener noreferrer">{exp.company}</a>
                  ) : (
                    exp.company
                  )}
                </p>
              </div>
              <span class="timeline-period">{exp.period}</span>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<style>
  .section {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-2xl) var(--space-md);
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-lg);
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .section-heading::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .timeline {
    display: grid;
    gap: var(--space-lg);
  }

  .timeline-item {
    padding-left: var(--space-lg);
    border-left: 1px solid var(--color-border);
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 6px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .timeline-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .timeline-company {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .timeline-period {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .timeline-summary {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-top: var(--space-sm);
  }

  /* Drawer styles */
  .drawer {
    cursor: pointer;
  }

  .drawer-summary {
    list-style: none;
    position: relative;
  }

  .drawer-summary::-webkit-details-marker {
    display: none;
  }

  .drawer-summary::marker {
    display: none;
    content: '';
  }

  .drawer summary {
    list-style-type: none;
  }

  .drawer-chevron {
    display: block;
    margin-top: var(--space-sm);
    width: 16px;
    height: 16px;
    position: relative;
  }

  .drawer-chevron::before {
    content: '';
    position: absolute;
    top: 4px;
    left: 2px;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--color-text-muted);
    border-bottom: 2px solid var(--color-text-muted);
    transform: rotate(45deg);
    transition: transform 0.2s;
  }

  details[open] .drawer-chevron::before {
    transform: rotate(-135deg);
    top: 6px;
  }

  .drawer-content {
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    animation: slideDown 0.2s ease-out;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .drawer-details {
    list-style: none;
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .drawer-details li {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    padding-left: var(--space-md);
    position: relative;
  }

  .drawer-details li::before {
    content: '›';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  .drawer-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  @media (max-width: 640px) {
    .timeline-header {
      flex-direction: column;
      gap: 0;
    }

    .timeline-period {
      margin-top: 2px;
    }
  }
</style>
