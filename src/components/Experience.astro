  {
    role: 'Senior Full Stack Developer',
    company: 'Scenset',
    url: 'https://scenset.com/',
    period: '2021 – 2025',
    summary: 'Frontend and backend for a personalized travel platform.',
    details: [
      'Built internal and client-facing applications for personalized trip recommendations.',
      'Full-stack development with React frontend and Node.js backend services.',
      'Infrastructure on GCP using Pulumi for infrastructure-as-code.',
    ],
    tech: ['React', 'Node.js', 'Cloud Firestore', 'Algolia', 'PostgreSQL', 'GCP', 'Pulumi', 'Cloud Run'],
  },
  {
    role: 'Senior Backend Developer',
    company: 'optilyz',
    url: 'https://www.optilyz.com/',
    period: '2020 – 2021',
    summary: "Internal and external APIs for Europe's leading direct mail automation software.",
    details: [
      "Designed and developed APIs for optilyz's cross-channel marketing platform.",
