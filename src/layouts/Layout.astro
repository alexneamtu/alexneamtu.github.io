---
import Nav from '../components/Nav.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/print.css';

interface Props {
  title: string;
}
const { title } = Astro.props;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alexandru Neamtu',
  alternateName: 'Alex Neamtu',
  jobTitle: 'Senior Software Engineer',
  email: 'mailto:alexneamtu@gmail.com',
  url: 'https://alexneamtu.github.io',
  address: { '@type': 'PostalAddress', addressLocality: 'Bucharest', addressCountry: 'RO' },
  worksFor: { '@type': 'Organization', name: 'Sand Technologies' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Politehnica University of Bucharest' },
  knowsAbout: ['TypeScript', 'Node.js', 'Python', 'AWS', 'GraphQL', 'PostgreSQL', 'DynamoDB', 'Elasticsearch', 'React', 'Docker'],
  sameAs: ['https://github.com/alexneamtu', 'https://www.linkedin.com/in/alexneamtu/', 'https://x.com/neamtualexandru'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alex Neamtu — Senior Software Engineer in Bucharest, remote. 20+ years building backend, platform, and AI systems: serverless AWS, TypeScript, Node.js, Python, LLM-powered products." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Alex Neamtu — Senior Software Engineer in Bucharest, remote. 20+ years building backend, platform, and AI systems: serverless AWS, TypeScript, Node.js, Python, LLM-powered products." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://alexneamtu.github.io" />
    <meta property="og:image" content="https://alexneamtu.github.io/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.setAttribute('data-theme',
        localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <link rel="canonical" href="https://alexneamtu.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <Nav />
    <main style="padding-top: 4rem;">
      <slot />
    </main>
  </body>
</html>
